    s.add_argument("--reports-to", dest="reports_to", help="보고선(기본: 나)")
    s.add_argument("--task",
                   help="첫 지시. claude=배속 완료 후 am 메시지로 배달. "
                        "codex=기동 직후 TUI 에 직접 입력한다(푸시 채널이 그것뿐이고, "
                        "첫 턴이 돌아야 스캐너에 보인다)")
    s.add_argument("--install-hooks", dest="install_hooks", action="store_true",
                   help="대상 레포에 am 훅이 없으면 .claude/settings.local.json 에 설치")
    s.add_argument("--ephemeral", action="store_true",
                   help="프로브 채용 — 로스터(am agents)에서 감춘다. 배달은 정상")
    s.add_argument("--provider", choices=["claude", "codex"], default="claude",
                   help="팀원을 어느 CLI 로 띄울지. codex 는 배달 경로가 다르다 — "
                        "발견은 스캐너, 푸시 주입 없음(아래 delivery 참조)")
