def cmd_read(a):
    """스레드 id 든 메시지 id 든 받는다.

    🔴 예전엔 스레드만 받았는데, relay 공지는 **메시지 id 만** 인용한다("정정: m-X 에
    …"). 그래서 공지를 받은 쪽이 m-X 를 조회하면 빈 응답이 나왔고, 데이터가 없는 줄
    알고 "숨은 조건이 있나" 의심하다 한 세션이 머지를 보류하는 실비용까지 났다.
    조회 축이 인용 축과 다르면 그 인용은 조용한 막다른 길이 된다.
    """
    key = a.thread
    if key.startswith("m-"):
        m = call("GET", "/message", params=f"?id={urllib.parse.quote(key)}")
        msg = (m or {}).get("message")
        if not msg:
            out({"error": "unknown-id", "id": key,
                 "hint": "메시지·스레드 어느 쪽으로도 찾지 못했다."})
            return
        key = msg["thread"]          # 그 메시지가 속한 스레드 전문으로 넓혀 보여준다
    out(call("GET", "/read", params=f"?thread={urllib.parse.quote(key)}"))


def cmd_reply(a):
    # thread 로 reply 하면 그 스레드의 마지막 비-reply 메시지에 답한다
    r = call("GET", "/read", params=f"?thread={a.thread}")
    target = None
    for m in (r.get("messages", []) if isinstance(r, dict) else []):
        if m["type"] not in ("reply", "notice") and m["to_agent"] == _my_name():
            target = m["id"]
        elif m["type"] not in ("reply", "notice") and not target:
            target = m["id"]
    if not target:
        target = a.thread  # 메시지 id 를 직접 준 경우
    out(call("POST", "/reply", {"reply_to": target, "from_agent": _my_name(),
                                "from_session": SESSION, "body": a.text}))


def cmd_defer(a):
    out(call("POST", "/defer", {"id": a.id}))


def cmd_decide(a):
    body = {"from_session": _resolve_session(), "from_agent": _my_name(), "to": "broadcast",
            "type": "decide", "priority": "fyi", "thread": a.thread,
            "body": a.text, "repo": _repo()}
    r = call("POST", "/send", body)
    if a.record and os.path.exists(os.path.dirname(os.path.abspath(a.record)) or "."):
        with open(a.record, "a") as f:
            f.write(f"\n<!-- am decide {a.thread} -->\n- 합의: {a.text}\n")
    out(r)


def _repo():
    try:
        url = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, timeout=3).stdout.strip()
        return os.path.basename(url) if url else ""
    except Exception:  # noqa: BLE001
        return ""


def _branch():
    try:
        return subprocess.run(["git", "branch", "--show-current"],
                              capture_output=True, text=True, timeout=3).stdout.strip()
    except Exception:  # noqa: BLE001
        return ""


def _git_log(path, root=None):
    """질의 경로의 레포에서 조회 — cwd 레포에서 돌리면 레포 밖 경로에 항상 빈 결과."""
    root = root if root is not None else _repo_root_of(path)
    if not root:
        return ""
    try:
        return subprocess.run(["git", "-C", root, "log", "--oneline", "-5", "--",
                               os.path.abspath(path)],
                              capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:  # noqa: BLE001
        return ""


def _design_docs(root=None):
    base_dir = root or os.getcwd()
    docs = []
    for sub in (".claude", "."):
        d = os.path.join(base_dir, sub)
        if os.path.isdir(d):
            docs += [os.path.relpath(os.path.join(d, f), base_dir)
                     for f in os.listdir(d)
                     if f.startswith("DESIGN-") and f.endswith(".md")]
    return docs[:20]


def _my_name():
    return os.environ.get("AM_NAME", f"session-{SESSION[:8]}" if SESSION else "unknown")


