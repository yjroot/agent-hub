def cmd_ask(a):
    """--to 를 여러 번 주면 각자에게 개별 배달한다.

    브로드캐스트를 '한 건 기록'으로 만들지 않는 이유: 배달·ack·재큐가 전부 메시지
    단위라, 한 행을 N 명이 나눠 가지면 누가 봤는지 못 가른다. am decide 가 그 형태인데
    그건 애초에 배달되지 않는 **기록 전용**이다(실측: to_agent='broadcast' → 즉시
    acknowledged). 공지를 실제로 배달하려면 수신자마다 한 건이어야 한다.
    """
    if a.to and len(a.to) > 1:
        sent, failed = [], []
        for name in a.to:
            one = argparse.Namespace(**{**vars(a), "to": [name], "blocking": False})
            r = _ask_one(one)
            (sent if isinstance(r, dict) and r.get("ok") else failed).append(
                {"to": name, "result": r})
        out({"ok": not failed, "fanout": len(a.to), "sent": len(sent),
             "failed": failed or None})
        return
    out(_ask_one(a))


def _ask_one(a):
    root = _repo_root_of(a.owner_of) if a.owner_of else None
    # --to 오타 방어: 보내기 전에 수신자가 실재하는지 확인한다. 예전엔 응답이
    # {ok,id,thread} 뿐이라 오타가 조용히 새 대상을 만드는지 알 수 없었다(실측 피드백).
    to_name = a.to[0] if isinstance(a.to, list) else a.to
    if to_name:
        chk = call("GET", "/agent", params=f"?name={urllib.parse.quote(to_name)}")
        target = (chk or {}).get("agent")
        if not target:
            return {"ok": False, "error": "unknown-recipient", "to": to_name,
                    "hint": "am agents 로 정확한 이름을 확인해라 (오타 방지)."}
    body = {"from_session": _resolve_session(), "from_agent": a.as_name or _my_name(),
            "owner_of": _norm_path(a.owner_of, root) if a.owner_of else None,
            "to": to_name, "type": "consult",
            "priority": ("blocking" if a.blocking else
                         "fyi" if getattr(a, "fyi", False) else "normal"),
            "body": a.text, "revive_confirm": bool(a.revive_confirm),
            "repo": os.path.basename(root) if root else _repo()}
    r = call("POST", "/send", body)
    if isinstance(r, dict) and r.get("error") == "no-owner":
        # 빈손 실패 금지 — git 근거 폴백을 즉석 제시 (설계 §1-4)
        r["git_log"] = _git_log(a.owner_of, root)
        r["design_docs"] = _design_docs(root)
        r["hint"] = ("소유자 미등록. 위 git_log 의 커밋·DESIGN 문서로 자가해결하거나, "
                     "am agents 로 관련 세션을 찾아 --to 로 직접 물어라.")
    elif isinstance(r, dict) and r.get("ok") and to_name:
        # 해석된 수신자와 그 상태를 되돌려준다 — 발신자가 스스로 검증할 수 있게
        r["delivered_to"] = {"name": target["name"], "state": target["state"],
                             "task": " ".join((target.get("task") or "").split())[:60]}
    if a.blocking and isinstance(r, dict) and r.get("ticket"):
        out(r)
        out(call("GET", "/wait", params=f"?ticket={r['ticket']}&for=50", timeout=70))
        return {"ok": True, "waited": True}
    return r


def cmd_wait(a):
    if a.cancel:
        out(call("POST", "/cancel", {"ticket": a.ticket}))
        return
    out(call("GET", "/wait", params=f"?ticket={a.ticket}&for={a.for_s}", timeout=a.for_s + 20))


def cmd_review(a):
    # 응답자는 Bash 차단(화이트리스트 Read/Grep/Glob) — diff 를 파일로 저장해 전달.
    # 위치는 ~/.agent-hub/review/ — 워커가 스폰에 --add-dir 로 읽기 권한을 부여한다
    # (저자 fork 리뷰 R0: /tmp 는 응답자가 권한상 못 읽음이 실측됨)
    review_dir = os.path.expanduser("~/.agent-hub/review")
    os.makedirs(review_dir, exist_ok=True)
    diff_path = os.path.join(review_dir, f"am-review-{os.getpid()}.diff")
    try:
        diff = subprocess.run(["git", "diff", a.range], capture_output=True,
                              text=True, timeout=15).stdout
        with open(diff_path, "w") as f:
            f.write(diff)
    except Exception as e:  # noqa: BLE001
        out({"error": f"git diff 실패: {e}"})
        return
    body = {"from_session": _resolve_session(), "from_agent": a.as_name or _my_name(),
            "owner_of": a.owner_of, "type": "review", "priority": "blocking",
            "body": f"리뷰 요청 range={a.range} focus={a.focus or ''} — "
                    f"diff 파일을 Read 도구로 읽어라: {diff_path}",
            "refs": {"diff": a.range, "paths": [diff_path]}, "repo": _repo(),
            "revive_confirm": bool(getattr(a, "revive_confirm", False))}
    r = call("POST", "/send", body)
    out(r)
    if isinstance(r, dict) and r.get("ticket"):
        w = call("GET", "/wait", params=f"?ticket={r['ticket']}&for=50", timeout=70)
        out(w)


def cmd_inbox(a):
    # 🔴 신원 미해결을 '메시지 없음'으로 말하면 안 된다. 실측: codex 팀원이 am inbox 를
    # 치면 같은 순간 실제로 대기 중인 메시지가 있는데도 {"items": []} 이 나왔다 —
    # 빈 SESSION 으로 조회했기 때문이다. "네가 누군지 모르겠다"와 "받은 게 없다"는
    # 전혀 다른 말이고, 앞의 것을 뒤의 것으로 바꾸면 팀원이 지시를 영영 못 본다.
    sid = _resolve_session()
    if not sid:
        msg = {"error": "unknown-self",
               "reason": "내 세션을 특정하지 못했다 — 수신함이 비었다는 뜻이 아니다.",
               "hint": "codex 등 세션 env 가 없는 CLI 라면 AM_NAME 을 세팅하거나 "
                       "`am register --name <내이름>` 후 다시 시도해라."}
        if a.check:
            print(f"[agent-hub] {msg['reason']} {msg['hint']}")
            sys.exit(1)
        out(msg)
        sys.exit(2)
    r = call("GET", "/inbox", params=f"?session={sid}", timeout=3)
    items = r.get("items", []) if isinstance(r, dict) else []
    if a.check:
        if not items and "degraded" not in (r or {}):
            sys.exit(1)
        # 봉투 문구 정본 = common/envelope.py (UDS 웨이크 경로와 단일화)
        print(render_inbox(items,
                           degraded=r.get("degraded") if isinstance(r, dict) else None,
                           me=r.get("me") if isinstance(r, dict) else None))
        # 출력 성공 후에만 pop+ack (주입 확정 시점 = lease 시작)
        call("GET", "/inbox-ack", params=f"?session={sid}", timeout=3)
    else:
        out(r)


def cmd_agents(a):
    # --all: 프로브·일회용(ephemeral) 세션까지. 감사용 탈출구가 없으면 '감춘다'가
    # 곧 '없앤다'가 된다 — relay 는 all=1 을 받아주는데 CLI 에 통로가 없었다.
    r = call("GET", "/agents",
             params=f"?state={a.state or ''}&limit={a.limit}"
                    f"{'&all=1' if a.all else ''}", timeout=25)
    # 🔴 조회 실패를 빈 목록으로 표시하면 안 된다. 머신 부하(load 44·워커 응답 29초
    # 실측)로 타임아웃 나던 날 이 명령이 "(등록된 에이전트 없음)"을 찍어, 운영자가
    # 레지스트리가 죽은 줄 알고 결함 리포트를 냈다 — 조용한 오답이다.
    if isinstance(r, dict) and r.get("error"):
        print(f"⚠️ 조회 실패(목록이 비어 있다는 뜻이 아니다): {r['error']}")
        print("   워커가 제때 응답하지 않았다. 머신 부하가 높으면 느려진다 —")
        print("   `uptime` 으로 load 를 보고 잠시 후 재시도해라.")
        sys.exit(2)
    me = SESSION[:8] if SESSION else None
    rows = r.get("agents", []) if isinstance(r, dict) else []
    # 헤더 필수: 첫 사용자가 3번째(상태)와 4번째(무응답 시간) 칸의 축 차이도,
    # 5번째 칸이 레포라는 것도 알 수 없었다는 실측 피드백. 저자 특정의 결정적 근거가
    # '의미를 모르는 칸'에 들어 있으면 안 된다.
    print(f"{'NAME':<24}{'':<6} {'ROLE':<9} {'TEAM':<12} {'STATE':<12} "
          f"{'IDLE':<12} {'REPO':<14} TASK")
    for ag in rows:
        idle = ag.get("idle_s") or 0
        idle_str = f"{idle//3600}h{(idle%3600)//60:02d}m" if idle >= 3600 \
            else f"{idle//60}m"
        you = " (you)" if me and me in ag["name"] else (
            " (probe)" if ag.get("ephemeral") else "")
        # 🔑 목록이 답해야 할 질문은 "지금 뭘 하고 있나"다(사용자 기대 실측). 그래서
        # 최근 프롬프트를 우선 보여준다. 단 **스스로 붙인 라벨은 밀리지 않는다** —
        # 'Agent Hub 저자' 같은 라벨은 최근 프롬프트보다 조회에 유용하고, 그런 세션은
        # 자기가 원할 때 갱신하면 된다. 라벨이 있는 행은 앞에 · 로 표시한다.
        explicit = bool(ag.get("task_explicit") or ag.get("cmux_title"))
        shown = (ag.get("cmux_title") or
                 (ag.get("task") if explicit else
                  (ag.get("recent_prompt") or ag.get("task")))) or ""
        task = ("· " if explicit else "") + " ".join(shown.split())[:58]
        # repo 는 명시 register 에서만 차서 실측 181/183 이 공란인데 cwd 는 183/183
        # 차 있다. 있는 정보를 버리고 빈 칸을 보일 이유가 없다.
        place = (ag.get("repo")
                 or os.path.basename((ag.get("cwd") or "").rstrip("/")) or "-")
        role = (ag.get("role") or "-")[:8]
        team = (ag.get("team") or "-")[:11]
        print(f"{ag['name']:<24}{you:<6} {role:<9} {team:<12} {ag['state']:<12} "
              f"idle:{idle_str:<7} {place[:14]:<14} {task}")
    if not rows:
        print("(등록된 에이전트 없음)")
    elif isinstance(r, dict) and r.get("truncated"):
        # 절단을 조용히 하면 "없음"으로 읽힌다(실측: PM 이 실재 세션 7곳을 없다고 판독)
        more = r["total"] - r["shown"]
        print(f"… {more}개 더 있음 (전체 {r['total']}) — `am agents --limit {r['total']}` "
              f"또는 `--state live-idle` 등으로 좁혀서 보세요")



