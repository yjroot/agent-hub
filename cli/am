CLAUDE_SESSIONS_DIR = os.path.expanduser("~/.claude/sessions")
CODEX_LOCKS_DIR = os.path.expanduser("~/.codex/thread-writer-locks")


def _launched_since(provider, t0):
    """기동 흔적이 있는가. 재전송 여부를 가르는 유일한 근거다.

    🔴 '이미 떠 있으면 재전송은 무해하다'는 내 가정이 틀렸다. 셸 프롬프트에는 무해하지만
    **TUI 에는 그 줄이 그대로 타이핑된다** — 사용자가 codex 입력창에서
    `AM_NAME=… codex --dangerously-bypass-approvals-and-sandbox` 를 발견했다.
    그래서 '등록이 안 됐다'가 아니라 '**기동조차 안 됐다**'를 근거로 삼는다.
    두 흔적 모두 **턴 완료 전, 기동 시점에** 생긴다(실측):
      claude : ~/.claude/sessions/<pid>.json
      codex  : ~/.codex/thread-writer-locks/<thread>.lock
    """
    d = CODEX_LOCKS_DIR if provider == "codex" else CLAUDE_SESSIONS_DIR
    try:
        for fn in os.listdir(d):
            if os.path.getmtime(os.path.join(d, fn)) >= t0 - 2:
                return fn
    except OSError:
        return None      # 디렉터리가 없으면 판정 불가 — 재전송하지 않는다(오염이 더 비싸다)
    return None


def cmd_hire(a):
    steps = []

    def step(label, **kw):
        steps.append({"step": label, "ok": True, **kw})

    def fail(err, **kw):
        # 실패는 단계 기록과 함께 **크게** 말한다 — '못 찾음'을 '없음'으로 바꾸지 않는다
        out({"ok": False, "error": err, "steps": steps, **kw})
        sys.exit(1)

    if a.pin_cwd:
        pin = os.path.realpath(a.pin_cwd)
        if not (os.path.isabs(a.pin_cwd) and os.path.isdir(pin)):
            fail("bad-pin", given=a.pin_cwd, hint="핀은 존재하는 절대경로만.")
        os.makedirs(os.path.dirname(HIRE_CONF), exist_ok=True)
        tmp_path = HIRE_CONF + ".tmp"
        with open(tmp_path, "w") as f:
            json.dump({"cwd": pin}, f, ensure_ascii=False, indent=2)
        os.replace(tmp_path, HIRE_CONF)   # 공용 설정 — 원자 교체
        out({"ok": True, "pinned_cwd": pin, "conf": HIRE_CONF})
        return

    if not NAME_RE.match(a.name or ""):
        fail("bad-name", name=a.name,
             hint="이름은 영숫자로 시작, [A-Za-z0-9._-] 32자 이내 — "
                  "기동 셸 라인(AM_NAME=…)에 실리므로 제한한다")
    if a.reports_to and not NAME_RE.match(a.reports_to):
        fail("bad-reports-to", reports_to=a.reports_to)
    new_ws_title = (a.new_workspace or "").strip()
    if new_ws_title and a.workspace:
        fail("workspace-conflict",
             hint="--workspace(기존 팀 합류)와 --new-workspace(새 팀 창설)는 동시에 못 쓴다.")
    if a.role == "lead" and not a.workspace and not new_ws_title:
        # 팀장 = 새 팀(사용자 결정 2026-09-02). 내 워크스페이스로 조용히 폴백하면
        # 팀장이 남의 팀 탭에 앉는다 — 기존 팀을 맡기는 경우만 --workspace 로 명시.
        fail("lead-needs-workspace",
             hint="팀장 채용은 --new-workspace <팀이름> 으로 새 팀을 만들거나, "
                  "기존 팀을 맡기면 --workspace <ref> 를 명시해라.")
    ws = a.workspace or ("" if new_ws_title else os.environ.get("CMUX_WORKSPACE_ID", ""))
    if not ws and not new_ws_title:
        fail("no-workspace",
             hint="cmux 세션 밖이다 — --workspace <ref> 를 명시해라. "
                  "팀 = cmux 워크스페이스이므로 채용은 워크스페이스가 정해져야 한다.")

    # 시작 폴더 — 핀이 있으면 핀만 쓴다("항상 고정"). 상대경로는 채용자 cwd 에
    # 붙어 엉뚱한 폴더가 되는 게 바로 그 실사례라 절대경로만 받는다.
    pinned = _hire_pinned_cwd()
    if a.cwd and not os.path.isabs(a.cwd):
        fail("relative-cwd", cwd=a.cwd,
             hint="상대경로는 채용자의 현재 폴더에 붙는다 — 절대경로만.")
    if pinned and a.cwd and os.path.realpath(a.cwd) != os.path.realpath(pinned):
        fail("cwd-pinned", pinned=pinned, given=a.cwd,
             hint="시작 폴더는 핀으로 고정돼 있다 — 바꾸려면 "
                  "`am hire --pin-cwd <path>` 로 핀 자체를 옮겨라.")
    cwd = os.path.realpath(a.cwd or pinned)
    if not (a.cwd or pinned):
        fail("no-cwd",
             hint="--cwd 도 핀도 없다 — `am hire --pin-cwd <path>` 로 기본 시작 "
                  "폴더를 박아 두면 이후 채용은 --cwd 없이 항상 거기서 시작한다.")
    if not os.path.isdir(cwd):
        fail("bad-cwd", cwd=cwd)
    if pinned and not a.cwd:
        step("pinned-cwd", cwd=cwd)

    # 🪤 함정② — 훅이 없으면 유령 사원이 된다. 조용히 진행 금지.
    # provider 마다 훅이 사는 곳이 다르다: claude=레포별 .claude/settings*.json,
    # codex=전역 ~/.codex/hooks.json. 같은 검사를 두 축에 걸치면 오판한다.
    if a.provider == "codex":
        # 🔑 codex 는 **훅이 아니라 스캐너**로 발견된다(워커가 ~/.codex/state_5.sqlite 를
        # 읽어 등록). 그래서 Claude 의 '레포에 훅이 있나' 검사를 그대로 적용하면 안 된다 —
        # 처음에 그렇게 짰다가 모든 codex 채용이 거부됐다. 축이 다르면 검사도 달라야 한다.
        if not os.path.exists(CODEX_STATE):
            fail("no-codex-state", path=CODEX_STATE,
                 reason="codex 상태 DB가 없다 — 워커가 세션을 발견할 경로가 없어 "
                        "채용해도 조직에 안 보인다(유령 사원).")
        step("discovery-check", provider="codex", via="state-scan", path=CODEX_STATE,
             note=_codex_hook_installed() and "am 훅도 설치돼 있다" or
                  "am 훅 없음 — 푸시 배달 불가(아래 delivery 참조)")
        root, hook_files = cwd, [CODEX_STATE]
    else:
        root, hook_files = _am_hook_settings(cwd)
    if a.provider != "codex" and not hook_files:
        if a.install_hooks:
            step("install-hooks", path=_install_am_hooks(root))
        else:
            fail("no-am-hook", repo_root=root,
                 reason="대상 레포에 am 훅(SessionStart)이 없다. 이대로 채용하면 세션은 "
                        "뜨지만 등록이 안 돼 조직에 보이지 않는다(유령 사원).",
                 hint="--install-hooks 로 .claude/settings.local.json 에 설치하고 "
                      "재시도하거나, 대상 레포에 직접 훅을 등록해라.")
    elif a.provider != "codex":
        step("hook-check", files=hook_files)

    # 워커 가용성 + 이름 선점을 채용 **전에** 확인 — 등록을 관찰할 수 없으면
    # 결과를 검증할 수 없고, 이름이 살아 있으면 relay 가 스쿼트 방어로 신입을
    # session-* 로 강등시켜 식별 축이 끊긴다.
    pre = call("GET", "/agent", params=f"?name={urllib.parse.quote(a.name)}")
    if not isinstance(pre, dict) or pre.get("error"):
        fail("worker-unreachable", detail=(pre or {}).get("error"),
             hint="등록을 관찰할 수 없으면 채용 결과 검증이 불가능하다 — 워커부터 살려라.")
    prev = pre.get("agent")
    if prev and str(prev.get("state", "")).startswith("live"):
        fail("name-taken", holder_session=prev.get("session"),
             hint="살아 있는 세션이 이 이름을 쓰고 있다. 그대로 진행하면 relay 스쿼트 "
                  "방어가 신입을 session-* 로 강등시켜 식별이 끊긴다 — 다른 이름을 써라.")
    step("preflight", name=a.name, workspace=ws, cwd=cwd)

    t0 = time.time()
    if new_ws_title:
        # 새 팀 창설(팀장 기본 경로): 워크스페이스를 만들면 터미널 서피스 1개를 갖고
        # 태어난다(실측 — index 0 = 첫 탭, cwd 는 --cwd). 새 탭을 덧붙이지 않고 그
        # 첫 탭에 팀장을 앉힌다: 탭이 둘이면 어느 쪽이 팀장인지 사람이 다시 찾아야
        # 하고, 빈 첫 탭은 유령 셸로 남는다.
        rc, sout, serr = _cmux_run(["workspace", "create", "--name", new_ws_title,
                                    "--cwd", cwd, "--focus", "false"])
        mw = re.search(r"\bworkspace:(\d+)", sout)
        if rc != 0 or not mw:
            fail("workspace-create-failed", rc=rc, stdout=sout, stderr=serr,
                 hint="cmux 소켓 capability 는 cmux 세션 env 에만 있다 — cmux 밖에서 "
                      "돌리면 조용히 실패한다. cmux 세션 안에서 실행해라.")
        ws = f"workspace:{mw.group(1)}"
        rc2, so2, se2 = _cmux_run(["list-pane-surfaces", "--workspace", ws,
                                   "--json", "--id-format", "both"])
        try:
            sfs = (json.loads(so2) or {}).get("surfaces", []) if rc2 == 0 else []
        except ValueError:
            sfs = []
        first = sorted(sfs, key=lambda x: x.get("index", 99))[0] if sfs else None
        if not first or not first.get("ref"):
            fail("workspace-first-surface-missing", workspace=ws, stdout=so2,
                 stderr=se2,
                 hint=f"워크스페이스는 만들어졌다 — 육안 확인 후 필요하면 "
                      f"`cmux workspace close --workspace {ws}` 로 닫아라.")
        sref = first["ref"]
        step("workspace-create", workspace=ws, title=new_ws_title,
             surface=sref, note="첫 탭(초기 서피스)에 앉힌다")
    else:
        # 🪤 함정① — --type agent-session 금지(하드코드로 봉쇄). agent-session 은 cmux
        # 자체 UI 라 Claude Code CLI 세션이 아니고, 훅도 메시징 소켓도 없어 am 으로
        # 지목이 불가능하다. 정상 세션은 전부 type=terminal 이다(팀장 실측).
        rc, sout, serr = _cmux_run(["new-surface", "--type", "terminal",
                                    "--workspace", ws, "--working-directory", cwd,
                                    "--focus", "false"])
        m = re.search(r"\bsurface:(\d+)", sout)
        if rc != 0 or not m:
            fail("spawn-failed", rc=rc, stdout=sout, stderr=serr,
                 hint="cmux 소켓 capability 는 cmux 세션 env 에만 있다 — cmux 밖(launchd·"
                      "ssh)에서 돌리면 빈 출력으로 조용히 실패한다. cmux 세션 안에서 실행해라.")
        sref = f"surface:{m.group(1)}"
        step("spawn", surface=sref, type="terminal")

    # 식별 축 주입: 이름·배속을 기동 env 로 싣는다. AM_ROLE/AM_REPORTS_TO 는 훅이
    # SessionStart 등록에 실어 줘서(함정③) 신입이 첫 화면부터 자기 위치를 안다.
    envp = f"AM_NAME={a.name} AM_ROLE={a.role} AM_REPORTS_TO={a.reports_to or _my_name()}"
    if a.ephemeral:
        envp += " AM_EPHEMERAL=1"
    # 🔑 --model 은 **반드시 명시**한다. 미지정이면 환경 기본값으로 조용히 폴백하는데,
    # 그 값은 채용자가 의도한 모델이 아닐 수 있다(실측 교훈: 부활 스폰에서 미지정이
    # 최고가 모델로 폴백해 과금됐다). 기본은 opus 5 — 팀원이 실제 구현을 맡는 자리다.
    if a.provider == "codex":
        # codex 는 --model 대신 -m, 승인 우회 플래그 이름도 다르다. AM_* env 는 실어
        # 두지만 codex 훅이 없으면 등록에 반영되지 않는다 — 식별은 스캐너 축으로 한다.
        model = a.model if a.model != HIRE_DEFAULT_MODEL else ""   # opus 는 codex 모델이 아니다
        launch = (f"{envp} codex{f' -m {model}' if model else ''} "
                  f"--dangerously-bypass-approvals-and-sandbox")
    else:
        launch = (f"{envp} claude --model {a.model} --dangerously-skip-permissions")
    # 🪤 갓 만든 서피스는 셸이 아직 준비 전이라 **입력이 통째로 유실된다**(실측: codex
    # 채용이 100초 타임아웃났는데 원인은 명령 자체가 아니라 셸 미준비였다 — 나중에
    # 같은 줄을 손으로 보내니 즉시 떴다). 'send 성공'은 '기동됨'이 아니다.
    # 준비 대기가 호출자의 예산을 잠식하면 안 된다 — timeout 의 1/4 을 넘지 않는다
    # (테스트가 이걸 잡았다: 1초 예산에 2.5초를 자면 등록을 관찰할 시간이 남지 않는다).
    time.sleep(min(HIRE_SHELL_WARMUP_S, a.timeout / 4))
    rc2, _o, err2 = _cmux_run(["send", "--workspace", ws, "--surface", sref, "--",
                               launch + "\\n"])
    if rc2 != 0:
        fail("launch-failed", rc=rc2, stderr=err2, surface=sref,
             surface_left_open="육안 확인용 — 끝나면 "
                               f"`cmux close-surface --workspace {ws} --surface {sref}`")
    step("launch", cmd=launch, model=a.model if a.provider != "codex" else None)

    if a.provider == "codex" and a.task:
        # 🔑 codex 는 **첫 턴을 마쳐야 조직에 보인다**. 스캐너 조건이 tokens_used>0 이고,
        # 그 행은 세션이 턴을 끝낼 때 쓰인다(실측: 기동만 한 세션은 threads 에 행이 없고
        # 락 파일·셸 스냅샷에만 존재했다. codex exec 로 한 턴 돌리자 즉시 행이 생겼다).
        # 그래서 codex 는 첫 지시를 am 이 아니라 **TUI 에 직접** 넣는다 — 그게 유일한
        # 푸시 채널이기도 하고(codex 엔 UDS 소켓이 없다), 동시에 발견 트리거다.
        time.sleep(min(HIRE_TUI_WARMUP_S, a.timeout / 4))
        # 🪤 본문과 엔터를 **갈라서** 보낸다. 셸 프롬프트에서는 `send "...\\n"` 이 제출까지
        # 되지만 TUI 입력창에서는 그 개행이 **붙여넣기 내용의 일부**가 되어 지시가 입력만
        # 되고 실행되지 않는다(실사용 보고: 사용자가 직접 엔터를 눌러야 했다).
        # send-key 는 별개 키 이벤트라 TUI 가 제출로 받는다.
        _cmux_run(["send", "--workspace", ws, "--surface", sref, "--",
                   a.task.replace("\n", " ")])
        time.sleep(HIRE_TUI_SUBMIT_GAP_S)
        rc3, _o3, err3 = _cmux_run(["send-key", "--workspace", ws, "--surface", sref,
                                    "--", "enter"])
        step("first-task-via-tui", submitted=(rc3 == 0),
             reason="codex 는 푸시 채널이 TUI 뿐이고, 첫 턴이 돌아야 스캐너에 보인다",
             note=None if rc3 == 0 else f"엔터 전송 실패({err3}) — 지시가 입력창에 "
                                        "남아 있을 수 있다. 서피스를 직접 확인해라")

    # 등록 대기 — 정확 조인: name(내가 정한 값) + registered_at>=t0 + cwd 일치.
    # cwd 까지 보는 이유: 폴링 중 동명의 옛(dormant) 행이나 경합 등록을 오인하지 않기 위함.
    # 🔑 식별 축이 provider 마다 다르다.
    #   claude : AM_NAME 을 훅이 등록에 실어 주므로 **이름 정확 조인**
    #   codex  : 훅이 없어 워커 스캐너가 codex-<id8> 로 이름을 짓는다 — 내가 정한 이름이
    #            안 붙는다. 그래서 cwd + 등록시각으로 좁히고, 찾은 뒤 /org 로 개명한다.
    #            (이 차이를 무시하고 이름으로 찾으면 codex 채용은 영원히 타임아웃난다.)
    ag, poll_errs, last_seen, resent = None, 0, None, False
    while time.time() < t0 + a.timeout:
        if a.provider == "codex":
            # 서버에서 축으로 걸러 받는다 — 전체를 긁으면 절단에 걸려 조용히 못 찾는다
            r = call("GET", "/agents",
                     params=f"?cli=codex&since={int(t0 - 2)}&limit=50&all=1",
                     timeout=20)
            rows = r.get("agents", []) if isinstance(r, dict) else []
            cands = [x for x in rows if x.get("cli") == "codex"
                     and os.path.realpath(x.get("cwd") or "") == cwd
                     and (x.get("registered_at") or 0) >= t0 - 2]
            cand = sorted(cands, key=lambda x: x.get("registered_at") or 0)[-1] \
                if cands else None
        else:
            r = call("GET", "/agent", params=f"?name={urllib.parse.quote(a.name)}")
            cand = r.get("agent") if isinstance(r, dict) else None
        if isinstance(r, dict) and r.get("error"):
            poll_errs += 1
        if cand:
            last_seen = {k: cand.get(k) for k in ("session", "cwd", "registered_at",
                                                  "state")}
            if a.provider == "codex" or (
                    (cand.get("registered_at") or 0) >= t0 - 2
                    and os.path.realpath(cand.get("cwd") or "") == cwd):
                ag = cand
                break
        if not resent and time.time() > t0 + a.timeout * HIRE_RESEND_AT:
            resent = True
            ev = _launched_since(a.provider, t0)
            if ev:
                # 떠 있는데 등록만 늦은 것이다 — 재전송하면 TUI 입력창을 오염시킨다.
                step("relaunch-skipped", evidence=ev,
                     reason="기동 흔적 있음 — 등록만 지연 중이다(재전송은 TUI 오염)")
            else:
                _cmux_run(["send", "--workspace", ws, "--surface", sref, "--",
                           launch + "\\n"])
                step("relaunch-once",
                     reason="기동 흔적 없음 — 셸 미준비로 입력이 유실된 것으로 본다")
        time.sleep(HIRE_POLL_S)
    if not ag:
        fail("register-timeout", waited_s=a.timeout, surface=sref,
             poll_errors=poll_errs, last_candidate=last_seen,
             reason="기동 후 등록을 관찰하지 못했다 — 세션이 안 떴거나, 훅이 안 돌았거나, "
                    "이름이 그 사이 선점돼 session-* 로 강등됐을 수 있다.",
             hint=[f"서피스는 증거 보존을 위해 열어 뒀다 — 육안 확인 후 "
                   f"`cmux close-surface --workspace {ws} --surface {sref}` 로 닫아라",
                   "`am agents --all` 에서 session-* 신규 행이 보이면 이름 강등이다",
                   "대상 레포 훅과 claude 기동 로그를 서피스에서 직접 확인해라"])
    # 🪤 로스터 응답은 조망용이라 session 같은 칸이 없다. 후보를 찾은 뒤에는 **전체
    # 레코드를 한 번 더 받아** 축을 단일화한다 — 오늘만 세 번, 생산자가 안 주는 칸을
    # 소비자가 읽어 조용히 실패했다(registered_at 부재 → 필터 항상 거짓, session 부재 → KeyError).
    full = call("GET", "/agent",
                params=f"?name={urllib.parse.quote(ag.get('name') or a.name)}")
    if isinstance(full, dict) and full.get("agent"):
        ag = {**ag, **full["agent"]}
    if not ag.get("session"):
        fail("agent-record-iexternal-systemplete", agent=ag,
             hint="등록은 관찰됐는데 세션 id 를 못 받았다 — `am agents` 로 확인 후 "
                  "`am org` 로 수동 배정해라.")
    step("registered", session=ag.get("session"),
         registered_at=ag.get("registered_at"),
         scanned_name=ag.get("name") if a.provider == "codex" else None)
    if a.provider == "codex" and ag.get("name") != a.name:
        # 스캐너가 지은 codex-<id8> 를 채용자가 정한 이름으로 바꾼다 — 지목·보고선이
        # 사람이 읽는 이름으로 서야 조직도가 쓸모 있다.
        rn = call("POST", "/org", {"name": ag["name"], "rename_to": a.name})
        step("rename", frm=ag["name"], to=a.name,
             ok=bool(isinstance(rn, dict) and rn.get("ok")),
             note=None if (isinstance(rn, dict) and rn.get("ok"))
                  else "개명 실패 — 스캐너 이름으로 지목해라")
        if isinstance(rn, dict) and rn.get("ok"):
            ag = dict(ag, name=a.name)

    # 🪤 함정③ — 역할 부여는 **첫 지시보다 먼저**. env 주입(AM_ROLE)이 이미 등록에
    # 반영됐어도 /org 로 한 번 더 확정한다(훅 구버전·env 유실에도 결과가 같도록).
    orgr = call("POST", "/org", {"name": a.name, "role": a.role,
                                 "reports_to": a.reports_to or _my_name()})
    if not (isinstance(orgr, dict) and orgr.get("ok")):
        fail("org-failed", detail=orgr, surface=sref, session=ag.get("session"),
             hint="세션은 떠 있다 — `am org` 로 수동 배정한 뒤 지시를 보내라. "
                  "배정 없이 지시부터 보내면 신입은 다음 세션까지 자기 위치를 모른다.")
    step("org", agent=orgr.get("agent"))

    if a.task and a.provider != "codex":
        sr = call("POST", "/send", {"from_session": _resolve_session(),
                                    "from_agent": _my_name(), "to": a.name,
                                    "type": "consult", "priority": "normal",
                                    "body": a.task, "repo": _repo()})
        if not (isinstance(sr, dict) and sr.get("ok")):
            fail("first-task-failed", detail=sr, surface=sref, session=ag["session"])
        step("first-task", thread=sr.get("thread"))

    out({"ok": True, "name": a.name, "session": ag["session"], "surface": sref,
         "workspace": ws, "cwd": cwd, "org": orgr.get("agent"), "steps": steps,
         "cleanup": f"cmux close-surface --workspace {ws} --surface {sref}"})


# ── fire — 해고를 명령 하나로 (hire 의 역연산) ────────────────────────────
#
# 종료 축(핵심 판단): **이름→세션→PID 는 조인으로만 잇는다.** 이 머신에서 이름·
# 패턴 킬은 금지다(공용 — pkill -f 가 환경 문자열까지 매칭해 무관 MCP 서버까지
# 죽인 실사고, 08-24). 그래서 relay 의 session 을 CC 자신이 쓰는 레지스트리
# (~/.claude/sessions/<pid>.json — pid 사망 시 CC 가 스스로 스윕)로 PID 로 바꾸고,
# 죽이기 **직전** lsof 로 그 PID 의 실제 cwd 가 등록된 cwd 와 같은지 대조한다.
#
# relay 는 손대지 않는다 — SIGTERM 이면 SessionEnd 훅이 돌아 원장이 dormant 로
# 접히고, 훅이 못 돌면(SIGKILL) 워커 생존 스윕이 강등한다. 상태는 이미 있는
# 기전이 정리하고, fire 는 그 기전이 못 하는 셋만 한다:
#   ① 프로세스 종료(검증된 PID)  ② 보고선 재배선(잘린 자리 아래가 허공을 보고
#   하게 두지 않는다)  ③ 이름 해제(묘비 개명 — 안 하면 같은 이름 재채용 시 옛
#   큐 메시지가 신입에게 배달되고, 이 이름 앞으로 오는 메시지가 유료 부활을 켠다).

FIRE_KILL_TIMEOUT_S = 15.0   # SIGTERM 후 SessionEnd 훅이 돌 시간
FIRE_KILL9_TIMEOUT_S = 5.0
FIRE_POLL_S = 0.25
CC_SESSIONS_DIR = os.path.expanduser("~/.claude/sessions")


def _alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except OSError:
        return False


def _kill(pid, sig):
    """실제 시그널 발사 지점 — 테스트가 이 한 곳만 갈아끼운다."""
    os.kill(int(pid), sig)


def _session_pid(session):
    """세션 id → (pid, meta). 정본은 CC 자신이 쓰는 ~/.claude/sessions/<pid>.json
    (워커 resolve_socket 과 같은 축) — relay 값이 아니라 디스크에서 직접 읽는다."""
    for f in glob.glob(os.path.join(CC_SESSIONS_DIR, "*.json")):
        try:
            with open(f) as fh:
                d = json.load(fh)
        except (OSError, ValueError):
            continue
        if d.get("sessionId") == session:
            return d.get("pid"), d
    return None, None


def _pid_cwd(pid):
    """PID 의 실제 cwd (lsof). 실패하면 "" — 판정 불가는 불일치와 다르게 다룬다."""
    try:
        o = subprocess.run(["lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn"],
                           capture_output=True, text=True, timeout=5).stdout
    except Exception:  # noqa: BLE001
        return ""
    for line in o.splitlines():
        if line.startswith("n"):
            return line[1:]
    return ""


def _pid_cmux_surface(pid):
    """PID 환경에서 CMUX_SURFACE_ID 추출 (macOS: ps -E 는 같은 uid 프로세스의 환경을
    보여준다). 서피스 정리는 **그 프로세스가 스스로 갖고 있던 id 로만** 한다 —
    제목·순서로 추정해 닫으면 남의 서피스를 닫는다."""
    try:
        o = subprocess.run(["ps", "-E", "-ww", "-o", "command=", "-p", str(pid)],
                           capture_output=True, text=True, timeout=5).stdout
    except Exception:  # noqa: BLE001
        return ""
    m = re.search(r"CMUX_SURFACE_ID=(\S+)", o)
    return m.group(1) if m else ""


def _locate_surface(surface_env_id):
    """env 의 surface id → (workspace ref, surface ref). common.cmux.resolve_self 와
    같은 순회 — cmux 소켓 capability 는 cmux 세션 안에만 있으므로 밖에서는 (None, None)."""
    if not surface_env_id:
        return None, None
    rc, sout, _err = _cmux_run(["workspace", "list", "--json", "--id-format", "both"])
    try:
        wss = (json.loads(sout) or {}).get("workspaces", []) if rc == 0 else []
    except ValueError:
        wss = []
    for w in wss:
        ref = w.get("ref")
        if not ref:
            continue
        rc2, so2, _e2 = _cmux_run(["list-pane-surfaces", "--workspace", ref,
                                   "--json", "--id-format", "both"])
        try:
            sfs = (json.loads(so2) or {}).get("surfaces", []) if rc2 == 0 else []
        except ValueError:
            sfs = []
        for sf in sfs:
            if surface_env_id in (sf.get("id"), sf.get("uuid")):
                return ref, sf.get("id") or sf.get("uuid")
    return None, None


def cmd_fire(a):
    steps = []

    def step(label, **kw):
        steps.append({"step": label, "ok": True, **kw})

    def fail(err, **kw):
        out({"ok": False, "error": err, "steps": steps, **kw})
        sys.exit(1)

    name = (a.name or "").strip()
    if not NAME_RE.match(name):
        fail("bad-name", name=name)
    if name == _my_name():
        fail("self-fire",
             hint="자기 세션은 해고가 아니라 종료다 — 그냥 세션을 끝내라. "
                  "해고는 남(보고선 위)이 한다.")

    r = call("GET", "/agent", params=f"?name={urllib.parse.quote(name)}")
    if not isinstance(r, dict) or r.get("error"):
        fail("worker-unreachable", detail=(r or {}).get("error"))
    ag = r.get("agent")
    if not ag:
        fail("unknown-agent", name=name)
    if ag.get("session") and ag.get("session") == _resolve_session():
        fail("self-fire", hint="이 이름의 최신 등록이 지금 이 세션이다.")
    if (ag.get("cli") or "claude") == "codex":
        # codex 는 CC 레지스트리에 없어 세션→PID 조인 자체가 없다 — 죽일 축이
        # 다르므로(TUI 서피스) 여기서 추정하지 않는다. hire 의 provider 분기와 동형.
        fail("codex-not-supported", name=name,
             hint="codex 세션은 ~/.claude/sessions 조인이 없다 — cmux 에서 해당 "
                  "서피스를 직접 닫고 `am org` 로 라벨을 정리해라.")

    # 조직 칸(role·reports_to)은 /agent 가 투영하지 않는다 — 로스터에서 읽는다
    roster = call("GET", "/agents", params="?limit=200&all=1")
    rows = roster.get("agents", []) if isinstance(roster, dict) else []
    me_row = next((x for x in rows if x.get("name") == name), {})
    if me_row.get("role") == "chairman" and not a.force:
        fail("target-is-chairman",
             hint="회장 해고는 실수일 가능성이 크다 — 맞다면 --force.")
    subs = [x for x in rows if x.get("reports_to") == name
            and str(x.get("state", "")).startswith("live")]

    state = str(ag.get("state") or "")
    if state == "live-active" and not a.force and not a.grace:
        fail("target-busy", state=state,
             hint="턴 진행 중이다 — 지금 죽이면 진행 중 작업·미커밋 산출이 유실된다. "
                  "--grace <초> 로 마무리 시간을 주거나, 감수하면 --force.")

    pid, _meta = _session_pid(ag.get("session") or "")
    if pid and not _alive(pid):
        pid = None
    if pid:
        realcwd = _pid_cwd(pid)
        regcwd = os.path.realpath(ag.get("cwd") or "") if ag.get("cwd") else ""
        if realcwd and regcwd and os.path.realpath(realcwd) != regcwd:
            fail("cwd-mismatch", pid=pid, proc_cwd=realcwd, registered_cwd=regcwd,
                 reason="PID 의 실제 cwd 가 등록 cwd 와 다르다 — PID 재사용·레지스트리 "
                        "오염 가능성. 이 PID 는 죽이지 않는다(kill-by-pid 규율).")
        step("identify", session=ag.get("session"), pid=pid,
             cwd=realcwd or "(lsof 판정 불가 — 레지스트리 조인만으로 진행)")
    else:
        step("identify", session=ag.get("session"), pid=None,
             note="살아있는 프로세스 없음 — 원장 정리(보고선·이름)만 한다")

    # 통지·유예 — 죽은 뒤에는 읽을 수 없으니 죽이기 전에 보낸다. 목적은 예의가
    # 아니라 **미커밋 산출 회수다**(커밋이 부활 비용을 없앤다 — 세션 안에만 있는
    # 산출은 유실되거나 유료 부활로만 되살아난다).
    if a.grace and pid:
        why = f" 사유: {a.reason}" if a.reason else ""
        call("POST", "/send", {
            "from_session": SESSION, "from_agent": _my_name(), "to": name,
            "type": "notice", "priority": "normal",
            "body": f"[해고 통지] {int(a.grace)}초 후 이 세션이 종료된다.{why} "
                    "미커밋 작업이 있으면 **지금 커밋**하고, 진행 중이던 일의 상태를 "
                    "이슈나 보고선에 한 줄 남겨라. 회신은 필요 없다.",
            "repo": _repo()})
        step("grace-notice", wait_s=a.grace)
        time.sleep(a.grace)

    surface_env = _pid_cmux_surface(pid) if pid else ""

    forced = False
    if pid:
        _kill(pid, signal.SIGTERM)   # TERM 먼저 — SessionEnd 훅이 돌아야 원장이 접힌다
        t0 = time.time()
        while _alive(pid) and time.time() < t0 + FIRE_KILL_TIMEOUT_S:
            time.sleep(FIRE_POLL_S)
        if _alive(pid):
            _kill(pid, signal.SIGKILL)
            forced = True
            t0 = time.time()
            while _alive(pid) and time.time() < t0 + FIRE_KILL9_TIMEOUT_S:
                time.sleep(FIRE_POLL_S)
        if _alive(pid):
            fail("kill-failed", pid=pid,
                 hint="SIGKILL 후에도 살아 있다 — 프로세스 상태를 직접 확인해라.")
        step("terminate", pid=pid, sigkill=forced,
             note="SIGKILL — SessionEnd 훅이 못 돌았으니 원장 강등은 워커 스윕이 한다"
                  if forced else "SIGTERM 종료 — SessionEnd 훅이 원장을 접는다")

    # 보고선 재배선 — 기본은 해고된 이의 상급자(없으면 나). 배정 실패는 크게 말하되
    # 나머지는 계속한다(라벨 관리 — 남은 것은 눈에 보이고 누구든 고칠 수 있다).
    new_boss = a.reassign_to or me_row.get("reports_to") or _my_name()
    for x in subs:
        rr = call("POST", "/org", {"name": x["name"], "reports_to": new_boss})
        step("reassign", agent=x["name"], to=new_boss,
             ok=bool(isinstance(rr, dict) and rr.get("ok")))

    # 이름 해제(묘비 개명) — 죽은 **뒤에** 한다(산 세션 개명은 자기 인식과 어긋난다).
    tomb = None
    if not a.keep_name:
        tomb = f"fired-{name}"[:26] + time.strftime("-%m%d")
        rn = call("POST", "/org", {"name": name, "rename_to": tomb})
        tomb_ok = bool(isinstance(rn, dict) and rn.get("ok"))
        step("tombstone", to=tomb, ok=tomb_ok,
             note=None if tomb_ok else "개명 실패 — 같은 이름 재채용 시 옛 큐 메시지가 "
                                       "신입에게 배달될 수 있다. `am org` 로 정리해라.")

    # 서피스 정리 — 죽은 프로세스가 스스로 갖고 있던 id 로만 지목한다(추정 금지)
    closed = None
    if surface_env and not a.keep_surface:
        ws_ref, sf_ref = _locate_surface(surface_env)
        if ws_ref and sf_ref:
            rc, _o, err = _cmux_run(["close-surface", "--workspace", ws_ref,
                                     "--surface", str(sf_ref)])
            closed = {"workspace": ws_ref, "surface": sf_ref, "ok": rc == 0}
            if rc != 0:
                closed["error"] = err
        else:
            closed = {"ok": False, "note": "서피스 미발견 — cmux 밖이거나 이미 닫힘"}
        step("close-surface", **closed)

    out({"ok": True, "name": name, "tombstone": tomb, "pid": pid,
         "sigkill": forced if pid else None,
         "reassigned": [x["name"] for x in subs], "reassigned_to":
             new_boss if subs else None,
         "surface": closed, "steps": steps,
         "note": None if pid else "프로세스는 이미 없었다 — 원장 정리만 수행"})


