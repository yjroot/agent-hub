#!/usr/bin/env python3
"""am — Agent Hub CLI (v0). 설계 정본: DESIGN-agent-messenger.md v4.2 §3.

에이전트가 Bash 로 호출하는 공통분모. 127.0.0.1 워커에만 접속.
stdlib only — 훅 핫패스에서도 기동이 빨라야 한다.

주의: 이 명령은 절대 백그라운드로 돌리지 말 것 (blocking 의미가 사라짐).
"""
import argparse
import json
import os
import subprocess
import sys
import urllib.request
import urllib.error

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from common.envelope import render_inbox  # noqa: E402

WORKER = os.environ.get("HUB_WORKER", "http://127.0.0.1:8791")
SESSION = os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("AM_SESSION", "")


def call(method, path, body=None, params="", timeout=10):
    url = f"{WORKER}{path}{params}"
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method,
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read())
    except (urllib.error.URLError, OSError) as e:
        return {"error": f"worker unreachable: {e}"}


def out(obj):
    print(json.dumps(obj, ensure_ascii=False, indent=2) if not isinstance(obj, str)
          else obj)


def cmd_register(a):
    body = {"session": a.session or SESSION, "name": a.name, "task": a.task or "",
            "paths": a.paths or [], "design": a.design or "", "cli": "claude",
            "repo": _repo(), "cwd": os.getcwd(), "model": a.model or "",
            "ephemeral": bool(a.ephemeral or os.environ.get("AM_EPHEMERAL")),
            "home": os.environ.get("HUB_HOME", "local")}
    out(call("POST", "/register", body))


def _repo_root_of(path):
    """질의 대상 경로가 속한 레포 루트. 없으면 None.

    🔴 조용한 오답 차단: 예전엔 정규화·repo·git_log·DESIGN 폴백이 전부 **CLI 실행 cwd**
    기준이었다. 그래서 issue-repo 에서 agent-hub 파일을 물으면 matches 0 + repo
    'issue-repo' + 남의 DESIGN 20건이 돌아왔다 — 같은 파일이 cwd 에 따라 '소유자 없음'
    과 '2건'으로 갈렸다(첫 사용자 실측). 축은 질의된 경로여야 한다.
    """
    d = os.path.abspath(path)
    if not os.path.isdir(d):
        d = os.path.dirname(d) or "."
    while not os.path.isdir(d):        # 아직 없는 파일도 상위로 올라가며 찾는다
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent
    try:
        root = subprocess.run(["git", "-C", d, "rev-parse", "--show-toplevel"],
                              capture_output=True, text=True, timeout=3).stdout.strip()
        return root or None
    except Exception:  # noqa: BLE001
        return None


def _norm_path(p, root=None):
    """레포 루트 상대로 정규화 — 이력 인덱서의 저장 축(세션 cwd 상대)과 정렬.

    root 를 주면 그 레포 기준(질의 경로가 속한 레포). 안 주면 cwd 레포 — 호출자가
    경로 축을 아는 경우에만 생략할 것.
    """
    root = root if root is not None else _repo_root_of(p)
    if root:
        rel = os.path.relpath(os.path.abspath(p), root)
        if not rel.startswith(".."):
            return rel
    return p


def cmd_who(a):
    root = _repo_root_of(a.path)
    p = _norm_path(a.path, root)
    repo = os.path.basename(root) if root else _repo()
    r = call("GET", "/who", params=f"?path={urllib.parse.quote(p)}&repo={repo}")
    if isinstance(r, dict) and not r.get("matches"):
        # 콜드스타트 폴백 (설계 §1-4): git log + DESIGN 문서.
        # 폴백도 **질의된 경로의 레포** 기준이어야 한다 — cwd 레포의 문서를 돌려주면
        # "소유자 없음"이라는 오답에 엉뚱한 근거를 붙여 확신을 준다.
        r = r or {}
        r["repo"] = repo
        r["git_log"] = _git_log(a.path, root)
        r["design_docs"] = _design_docs(root)
        if not root:
            r["hint"] = f"'{a.path}' 는 git 레포 밖이다 — 소유자 조회 축이 없다."
    out(r)


def cmd_claim(a):
    body = {"session": SESSION, "agent": a.as_name or _my_name(), "repo": _repo(),
            "paths": a.paths, "branch": a.branch or _branch(), "base": a.base or "",
            "issue": a.issue or "", "joint": a.joint or ""}
    out(call("POST", "/claim", body))


def cmd_ask(a):
    """--to 를 여러 번 주면 각자에게 개별 배달한다.

    브로드캐스트를 '한 건 기록'으로 만들지 않는 이유: 배달·ack·재큐가 전부 메시지
    단위라, 한 행을 N 명이 나눠 가지면 누가 봤는지 못 가른다. am decide 가 그 형태인데
    그건 애초에 배달되지 않는 **기록 전용**이다(실측: to_agent='broadcast' → 즉시
    acknowledged). 공지를 실제로 배달하려면 수신자마다 한 건이어야 한다.
    """
    if a.to and len(a.to) > 1:
        sent, failed = [], []
        for name in a.to:
            one = argparse.Namespace(**{**vars(a), "to": [name], "blocking": False})
            r = _ask_one(one)
            (sent if isinstance(r, dict) and r.get("ok") else failed).append(
                {"to": name, "result": r})
        out({"ok": not failed, "fanout": len(a.to), "sent": len(sent),
             "failed": failed or None})
        return
    out(_ask_one(a))


def _ask_one(a):
    root = _repo_root_of(a.owner_of) if a.owner_of else None
    # --to 오타 방어: 보내기 전에 수신자가 실재하는지 확인한다. 예전엔 응답이
    # {ok,id,thread} 뿐이라 오타가 조용히 새 대상을 만드는지 알 수 없었다(실측 피드백).
    to_name = a.to[0] if isinstance(a.to, list) else a.to
    if to_name:
        chk = call("GET", "/agent", params=f"?name={urllib.parse.quote(to_name)}")
        target = (chk or {}).get("agent")
        if not target:
            return {"ok": False, "error": "unknown-recipient", "to": to_name,
                    "hint": "am agents 로 정확한 이름을 확인해라 (오타 방지)."}
    body = {"from_session": SESSION, "from_agent": a.as_name or _my_name(),
            "owner_of": _norm_path(a.owner_of, root) if a.owner_of else None,
            "to": to_name, "type": "consult",
            "priority": ("blocking" if a.blocking else
                         "fyi" if getattr(a, "fyi", False) else "normal"),
            "body": a.text, "revive_confirm": bool(a.revive_confirm),
            "repo": os.path.basename(root) if root else _repo()}
    r = call("POST", "/send", body)
    if isinstance(r, dict) and r.get("error") == "no-owner":
        # 빈손 실패 금지 — git 근거 폴백을 즉석 제시 (설계 §1-4)
        r["git_log"] = _git_log(a.owner_of, root)
        r["design_docs"] = _design_docs(root)
        r["hint"] = ("소유자 미등록. 위 git_log 의 커밋·DESIGN 문서로 자가해결하거나, "
                     "am agents 로 관련 세션을 찾아 --to 로 직접 물어라.")
    elif isinstance(r, dict) and r.get("ok") and to_name:
        # 해석된 수신자와 그 상태를 되돌려준다 — 발신자가 스스로 검증할 수 있게
        r["delivered_to"] = {"name": target["name"], "state": target["state"],
                             "task": " ".join((target.get("task") or "").split())[:60]}
    if a.blocking and isinstance(r, dict) and r.get("ticket"):
        out(r)
        out(call("GET", "/wait", params=f"?ticket={r['ticket']}&for=50", timeout=70))
        return {"ok": True, "waited": True}
    return r


def cmd_wait(a):
    if a.cancel:
        out(call("POST", "/cancel", {"ticket": a.ticket}))
        return
    out(call("GET", "/wait", params=f"?ticket={a.ticket}&for={a.for_s}", timeout=a.for_s + 20))


def cmd_review(a):
    # 응답자는 Bash 차단(화이트리스트 Read/Grep/Glob) — diff 를 파일로 저장해 전달.
    # 위치는 ~/.agent-hub/review/ — 워커가 스폰에 --add-dir 로 읽기 권한을 부여한다
    # (저자 fork 리뷰 R0: /tmp 는 응답자가 권한상 못 읽음이 실측됨)
    review_dir = os.path.expanduser("~/.agent-hub/review")
    os.makedirs(review_dir, exist_ok=True)
    diff_path = os.path.join(review_dir, f"am-review-{os.getpid()}.diff")
    try:
        diff = subprocess.run(["git", "diff", a.range], capture_output=True,
                              text=True, timeout=15).stdout
        with open(diff_path, "w") as f:
            f.write(diff)
    except Exception as e:  # noqa: BLE001
        out({"error": f"git diff 실패: {e}"})
        return
    body = {"from_session": SESSION, "from_agent": a.as_name or _my_name(),
            "owner_of": a.owner_of, "type": "review", "priority": "blocking",
            "body": f"리뷰 요청 range={a.range} focus={a.focus or ''} — "
                    f"diff 파일을 Read 도구로 읽어라: {diff_path}",
            "refs": {"diff": a.range, "paths": [diff_path]}, "repo": _repo(),
            "revive_confirm": bool(getattr(a, "revive_confirm", False))}
    r = call("POST", "/send", body)
    out(r)
    if isinstance(r, dict) and r.get("ticket"):
        w = call("GET", "/wait", params=f"?ticket={r['ticket']}&for=50", timeout=70)
        out(w)


def cmd_inbox(a):
    r = call("GET", "/inbox", params=f"?session={SESSION}", timeout=3)
    items = r.get("items", []) if isinstance(r, dict) else []
    if a.check:
        if not items and "degraded" not in (r or {}):
            sys.exit(1)
        # 봉투 문구 정본 = common/envelope.py (UDS 웨이크 경로와 단일화)
        print(render_inbox(items,
                           degraded=r.get("degraded") if isinstance(r, dict) else None))
        # 출력 성공 후에만 pop+ack (주입 확정 시점 = lease 시작)
        call("GET", "/inbox-ack", params=f"?session={SESSION}", timeout=3)
    else:
        out(r)


def cmd_agents(a):
    # --all: 프로브·일회용(ephemeral) 세션까지. 감사용 탈출구가 없으면 '감춘다'가
    # 곧 '없앤다'가 된다 — relay 는 all=1 을 받아주는데 CLI 에 통로가 없었다.
    r = call("GET", "/agents",
             params=f"?state={a.state or ''}&limit={a.limit}"
                    f"{'&all=1' if a.all else ''}", timeout=25)
    # 🔴 조회 실패를 빈 목록으로 표시하면 안 된다. 머신 부하(load 44·워커 응답 29초
    # 실측)로 타임아웃 나던 날 이 명령이 "(등록된 에이전트 없음)"을 찍어, 운영자가
    # 레지스트리가 죽은 줄 알고 결함 리포트를 냈다 — 조용한 오답이다.
    if isinstance(r, dict) and r.get("error"):
        print(f"⚠️ 조회 실패(목록이 비어 있다는 뜻이 아니다): {r['error']}")
        print("   워커가 제때 응답하지 않았다. 머신 부하가 높으면 느려진다 —")
        print("   `uptime` 으로 load 를 보고 잠시 후 재시도해라.")
        sys.exit(2)
    me = SESSION[:8] if SESSION else None
    rows = r.get("agents", []) if isinstance(r, dict) else []
    # 헤더 필수: 첫 사용자가 3번째(상태)와 4번째(무응답 시간) 칸의 축 차이도,
    # 5번째 칸이 레포라는 것도 알 수 없었다는 실측 피드백. 저자 특정의 결정적 근거가
    # '의미를 모르는 칸'에 들어 있으면 안 된다.
    print(f"{'NAME':<24}{'':<6} {'CLI':<7} {'STATE':<12} {'IDLE':<12} "
          f"{'REPO':<16} TASK")
    for ag in rows:
        idle = ag.get("idle_s") or 0
        idle_str = f"{idle//3600}h{(idle%3600)//60:02d}m" if idle >= 3600 \
            else f"{idle//60}m"
        you = " (you)" if me and me in ag["name"] else (
            " (probe)" if ag.get("ephemeral") else "")
        # task 는 한 줄로 — 여러 줄이 그대로 흘러나와 목록이 깨졌다(실측)
        task = " ".join((ag.get("task") or "").split())[:60]
        print(f"{ag['name']:<24}{you:<6} {ag['cli']:<7} {ag['state']:<12} "
              f"idle:{idle_str:<7} {(ag['repo'] or '-'):<16} {task}")
    if not rows:
        print("(등록된 에이전트 없음)")


def cmd_read(a):
    """스레드 id 든 메시지 id 든 받는다.

    🔴 예전엔 스레드만 받았는데, relay 공지는 **메시지 id 만** 인용한다("정정: m-X 에
    …"). 그래서 공지를 받은 쪽이 m-X 를 조회하면 빈 응답이 나왔고, 데이터가 없는 줄
    알고 "숨은 조건이 있나" 의심하다 한 세션이 머지를 보류하는 실비용까지 났다.
    조회 축이 인용 축과 다르면 그 인용은 조용한 막다른 길이 된다.
    """
    key = a.thread
    if key.startswith("m-"):
        m = call("GET", "/message", params=f"?id={urllib.parse.quote(key)}")
        msg = (m or {}).get("message")
        if not msg:
            out({"error": "unknown-id", "id": key,
                 "hint": "메시지·스레드 어느 쪽으로도 찾지 못했다."})
            return
        key = msg["thread"]          # 그 메시지가 속한 스레드 전문으로 넓혀 보여준다
    out(call("GET", "/read", params=f"?thread={urllib.parse.quote(key)}"))


def cmd_reply(a):
    # thread 로 reply 하면 그 스레드의 마지막 비-reply 메시지에 답한다
    r = call("GET", "/read", params=f"?thread={a.thread}")
    target = None
    for m in (r.get("messages", []) if isinstance(r, dict) else []):
        if m["type"] not in ("reply", "notice") and m["to_agent"] == _my_name():
            target = m["id"]
        elif m["type"] not in ("reply", "notice") and not target:
            target = m["id"]
    if not target:
        target = a.thread  # 메시지 id 를 직접 준 경우
    out(call("POST", "/reply", {"reply_to": target, "from_agent": _my_name(),
                                "from_session": SESSION, "body": a.text}))


def cmd_defer(a):
    out(call("POST", "/defer", {"id": a.id}))


def cmd_decide(a):
    body = {"from_session": SESSION, "from_agent": _my_name(), "to": "broadcast",
            "type": "decide", "priority": "fyi", "thread": a.thread,
            "body": a.text, "repo": _repo()}
    r = call("POST", "/send", body)
    if a.record and os.path.exists(os.path.dirname(os.path.abspath(a.record)) or "."):
        with open(a.record, "a") as f:
            f.write(f"\n<!-- am decide {a.thread} -->\n- 합의: {a.text}\n")
    out(r)


def _repo():
    try:
        url = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, timeout=3).stdout.strip()
        return os.path.basename(url) if url else ""
    except Exception:  # noqa: BLE001
        return ""


def _branch():
    try:
        return subprocess.run(["git", "branch", "--show-current"],
                              capture_output=True, text=True, timeout=3).stdout.strip()
    except Exception:  # noqa: BLE001
        return ""


def _git_log(path, root=None):
    """질의 경로의 레포에서 조회 — cwd 레포에서 돌리면 레포 밖 경로에 항상 빈 결과."""
    root = root if root is not None else _repo_root_of(path)
    if not root:
        return ""
    try:
        return subprocess.run(["git", "-C", root, "log", "--oneline", "-5", "--",
                               os.path.abspath(path)],
                              capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:  # noqa: BLE001
        return ""


def _design_docs(root=None):
    base_dir = root or os.getcwd()
    docs = []
    for sub in (".claude", "."):
        d = os.path.join(base_dir, sub)
        if os.path.isdir(d):
            docs += [os.path.relpath(os.path.join(d, f), base_dir)
                     for f in os.listdir(d)
                     if f.startswith("DESIGN-") and f.endswith(".md")]
    return docs[:20]


def _my_name():
    return os.environ.get("AM_NAME", f"session-{SESSION[:8]}" if SESSION else "unknown")


def main():
    p = argparse.ArgumentParser(prog="am", description="Agent Hub messenger CLI")
    p.add_argument("--as", dest="as_name", help="표시용 발신자 이름 (신원은 세션으로 검증됨)")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("register")
    s.add_argument("--name")
    s.add_argument("--session")
    s.add_argument("--task")
    s.add_argument("--paths", nargs="*")
    s.add_argument("--design")
    s.add_argument("--model")
    s.add_argument("--ephemeral", action="store_true",
                   help="프로브·일회용 세션 — am agents/who 목록에서 감춘다 (배달은 정상)")
    s.set_defaults(fn=cmd_register)

    s = sub.add_parser("who")
    s.add_argument("--path", required=True)
    s.set_defaults(fn=cmd_who)

    s = sub.add_parser("claim")
    s.add_argument("--paths", nargs="+", required=True)
    s.add_argument("--branch")
    s.add_argument("--base")
    s.add_argument("--issue")
    s.add_argument("--joint")
    s.set_defaults(fn=cmd_claim)

    s = sub.add_parser("ask")
    s.add_argument("text")
    s.add_argument("--owner-of", dest="owner_of", help="이 파일/경로의 소유자(저자)에게 보낸다 — 이름을 모를 때. 레포 밖 경로도 그 레포 기준으로 조회한다")
    s.add_argument("--to", action="append", help="수신자 이름 (am agents 의 NAME). 존재하지 않으면 보내기 전에 거부된다. 여러 번 지정하면 각자에게 개별 배달된다(공지용)")
    s.add_argument("--fyi", action="store_true", help="참고용 — 수신자에게 답할 의무가 없다. 미응답 재큐(반복 노출) 대상에서 빠진다. 공지·브로드캐스트는 이걸 써라")
    s.add_argument("--blocking", action="store_true", help="답을 최대 50초 인라인 대기. 미도착 시 티켓 반환 → am wait 로 재진입")
    s.add_argument("--revive-confirm", action="store_true", dest="revive_confirm", help="수신자가 종료된 세션이면 fork 부활로 답하게 승인한다 (유료: 예상 $5 초과 시 필요)")
    s.set_defaults(fn=cmd_ask)

    s = sub.add_parser("wait")
    s.add_argument("ticket")
    s.add_argument("--for", dest="for_s", type=int, default=50)
    s.add_argument("--cancel", action="store_true")
    s.set_defaults(fn=cmd_wait)

    s = sub.add_parser("review")
