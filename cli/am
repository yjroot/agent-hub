def cmd_board(a):
    """조직도 한 화면 — 라인·담당·현재 작업·라인 밖 발신량.

    강제가 없는 모델이라(사용자 결정) 이 화면이 규약을 지탱한다. 보이지 않는 규약은
    지켜지지 않는다 — 오늘 실측에서 역할 라벨이 시스템에 아예 없어 각자 '누구에게
    물어야 하나'를 매번 추측하고 있었다.
    """
    r = call("GET", "/board", params=f"?since_h={a.since_h}", timeout=25)
    if isinstance(r, dict) and r.get("error"):
        print(f"⚠️ 조회 실패: {r['error']}"); sys.exit(2)
    org = r.get("org", [])
    if not org:
        print("(live 에이전트 없음)"); return
    print(f"조직도 · 최근 {int(r.get('since_h', 48))}h 트래픽 · live {len(org)}곳")
    print(f"  {'NAME':<24}{'ROLE':<8}{'IDLE':<9}{'발신':>6}{'수신':>6}{'라인밖':>7}  현재 작업")
    by_team = {}
    for x in org:
        by_team.setdefault(x.get("team") or "(미배정)", []).append(x)
    for team in sorted(by_team, key=lambda t: (t == "(미배정)", t)):
        members = by_team[team]
        lead = next((m["name"] for m in members if m.get("role") == "lead"), None)
        print(f"\n▸ {team}" + (f"   팀장: {lead}" if lead else "   (팀장 미지정)"))
        for m in members:
            idle = m.get("idle_s")
            idle_s = "?" if idle is None else (f"{idle//3600}h{(idle%3600)//60:02d}m"
                                               if idle >= 3600 else f"{idle//60}m")
