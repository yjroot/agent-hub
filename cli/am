def _cmux_run(args, timeout=6):
    """cmux CLI 호출. 실패를 (rc, stdout, stderr) 로 **말한다** — hire 의 각 단계는
    판정 근거라 조용히 삼키면 안 된다(common.cmux._run 의 조용한 None 과 용도가 다르다)."""
    binp = os.environ.get("CMUX_BIN",
                          "/Applications/cmux.app/Contents/Resources/bin/cmux")
    try:
        p = subprocess.run([binp, *args], capture_output=True, text=True,
                           timeout=timeout)
        return p.returncode, (p.stdout or "").strip(), (p.stderr or "").strip()
    except FileNotFoundError:
        return 127, "", f"cmux 바이너리 없음: {binp}"
    except subprocess.TimeoutExpired:
        return 124, "", f"cmux {' '.join(args[:1])} {timeout}s 무응답"


def _am_hook_settings(cwd):
    """대상 cwd 에서 뜰 세션에 am 훅(SessionStart)이 걸리는 설정 파일 목록.

    🪤 함정②: 훅은 프로젝트별이다. 대상 레포에 훅이 없으면 채용해도 등록이 안 돼
    **조직에 안 보인다** — 팀장은 '채용했다'고 믿는데 신입은 유령이 된다(팀장 실측).
    그래서 채용 **전에** 검사한다.
    """
    root = _repo_root_of(cwd) or os.path.abspath(cwd)
    found = []
    for pth in (os.path.join(root, ".claude", "settings.json"),
                os.path.join(root, ".claude", "settings.local.json"),
                GLOBAL_SETTINGS):
        try:
            with open(pth) as f:
                cfg = json.load(f)
        except (OSError, json.JSONDecodeError):
            continue
        for ent in (cfg.get("hooks") or {}).get("SessionStart") or []:
            for h in ent.get("hooks") or []:
                if "am_hook.py" in (h.get("command") or ""):
                    found.append(pth)
    return root, found


def _install_am_hooks(root):
    """<root>/.claude/settings.local.json 에 am 훅 4종 병합 — 기존 키·훅은 보존."""
    hook_py = os.path.join(os.path.dirname(os.path.dirname(
        os.path.realpath(__file__))), "hooks", "am_hook.py")
    pth = os.path.join(root, ".claude", "settings.local.json")
    try:
        with open(pth) as f:
            cfg = json.load(f)
    except (OSError, json.JSONDecodeError):
        cfg = {}
    hooks = cfg.setdefault("hooks", {})
    for event, arg, tmo in HOOK_EVENTS:
        ents = hooks.setdefault(event, [])
        if any("am_hook.py" in (h.get("command") or "")
               for e in ents for h in (e.get("hooks") or [])):
            continue
        ents.append({"matcher": "", "hooks": [{
            "type": "command", "command": f"python3 {hook_py} {arg}",
            "timeout": tmo}]})
    os.makedirs(os.path.dirname(pth), exist_ok=True)
    with open(pth, "w") as f:
        json.dump(cfg, f, ensure_ascii=False, indent=2)
    return pth



CODEX_HOOKS = os.path.expanduser("~/.codex/hooks.json")
CODEX_STATE = os.path.expanduser("~/.codex/state_5.sqlite")


def _codex_hook_installed():
    """codex 는 훅이 **전역**이다(~/.codex/hooks.json) — Claude 의 레포별과 축이 다르다.

    같은 '훅 검사'라도 보는 곳이 다르므로 provider 별로 갈라야 한다. 레포에 .claude 가
    있다고 codex 세션이 등록되지는 않는다(그 반대도 마찬가지).
    """
    try:
        with open(CODEX_HOOKS) as f:
            h = (json.load(f) or {}).get("hooks") or {}
    except Exception:  # noqa: BLE001
        return []
    hit = []
    for ev in ("SessionStart", "UserPromptSubmit"):
        for grp in h.get(ev, []):
            for e in grp.get("hooks", []):
                if "am_hook" in str(e.get("command", "")):
                    hit.append(ev)
    return sorted(set(hit))


