def _resolve_session():
    """내 세션 id. codex 에는 이걸 알려주는 env 가 **없다**(실측: AM_* 만 있다).

    그래서 이름으로 되찾는다 — am hire 가 AM_NAME 을 주입했고, 스캐너가 등록한 뒤
    hire 가 그 이름으로 개명해 뒀으므로 relay 는 이름↔세션을 안다.
    이게 없으면 codex 팀원은 from_session 이 빈 값이라 신원 바인딩에서 탈락하고,
    등록·발신이 전부 403 이 된다(실사용 보고).
    """
    global SESSION
    if SESSION:
        return SESSION
    nm = os.environ.get("AM_NAME", "")
    if not nm:
        return ""
    r = call("GET", "/agent", params=f"?name={urllib.parse.quote(nm)}", timeout=8)
    SESSION = ((r or {}).get("agent") or {}).get("session") or ""
    return SESSION


def call(method, path, body=None, params="", timeout=10):
    url = f"{WORKER}{path}{params}"
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method,
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read())
    except (urllib.error.URLError, OSError) as e:
        return {"error": f"worker unreachable: {e}"}


