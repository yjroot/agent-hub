def _repo_root_of(path):
    """질의 대상 경로가 속한 레포 루트. 없으면 None.

    🔴 조용한 오답 차단: 예전엔 정규화·repo·git_log·DESIGN 폴백이 전부 **CLI 실행 cwd**
    기준이었다. 그래서 issue-repo 에서 agent-hub 파일을 물으면 matches 0 + repo
    'issue-repo' + 남의 DESIGN 20건이 돌아왔다 — 같은 파일이 cwd 에 따라 '소유자 없음'
    과 '2건'으로 갈렸다(첫 사용자 실측). 축은 질의된 경로여야 한다.
    """
    d = os.path.abspath(path)
    if not os.path.isdir(d):
        d = os.path.dirname(d) or "."
    while not os.path.isdir(d):        # 아직 없는 파일도 상위로 올라가며 찾는다
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent
    try:
        root = subprocess.run(["git", "-C", d, "rev-parse", "--show-toplevel"],
                              capture_output=True, text=True, timeout=3).stdout.strip()
        return root or None
    except Exception:  # noqa: BLE001
        return None


def _norm_path(p, root=None):
    """레포 루트 상대로 정규화 — 이력 인덱서의 저장 축(세션 cwd 상대)과 정렬.

    root 를 주면 그 레포 기준(질의 경로가 속한 레포). 안 주면 cwd 레포 — 호출자가
    경로 축을 아는 경우에만 생략할 것.
    """
    root = root if root is not None else _repo_root_of(p)
    if root:
        rel = os.path.relpath(os.path.abspath(p), root)
        if not rel.startswith(".."):
            return rel
    return p


def cmd_who(a):
    root = _repo_root_of(a.path)
    p = _norm_path(a.path, root)
    repo = os.path.basename(root) if root else _repo()
    r = call("GET", "/who", params=f"?path={urllib.parse.quote(p)}&repo={repo}")
    if isinstance(r, dict) and not r.get("matches"):
        # 콜드스타트 폴백 (설계 §1-4): git log + DESIGN 문서.
        # 폴백도 **질의된 경로의 레포** 기준이어야 한다 — cwd 레포의 문서를 돌려주면
        # "소유자 없음"이라는 오답에 엉뚱한 근거를 붙여 확신을 준다.
        r = r or {}
        r["repo"] = repo
        r["git_log"] = _git_log(a.path, root)
        r["design_docs"] = _design_docs(root)
        if not root:
            r["hint"] = f"'{a.path}' 는 git 레포 밖이다 — 소유자 조회 축이 없다."
    out(r)


